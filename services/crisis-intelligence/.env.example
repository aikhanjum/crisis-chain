DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/crisis_pool

# ACLED — OAuth password grant (https://acleddata.com/oauth/token); tokens cached in-process
ACLED_EMAIL=your@email.com
ACLED_PASSWORD=your_password
# Optional: static Bearer only if you do not want OAuth in this service
# ACLED_ACCESS_TOKEN=

# Severity threshold — regions above this score trigger pool deployment
SEVERITY_DEPLOY_THRESHOLD=60

# Downstream service URLs
AI_SUMMARY_URL=http://ai-summary:8002
BLOCKCHAIN_BRIDGE_URL=http://blockchain-bridge:4001

# Resend email — https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=CrisisChain <noreply@crisischain.org>
FRONTEND_URL=http://localhost:3000

# Invite token signing secret (any random string, keep secret)
INVITE_SECRET=change-me-in-production

# HDX HAPI v2 — NGO discovery (operational presence); https://hapi.humdata.org/docs
# Optional: if unset, ACLED_EMAIL is used for encode_app_identifier
# HDX_HAPI_CONTACT_EMAIL=your@email.com
HDX_HAPI_APPLICATION_NAME=CrisisChain
# HDX_HAPI_APP_IDENTIFIER=
# HDX_HAPI_BASE=https://hapi.humdata.org
