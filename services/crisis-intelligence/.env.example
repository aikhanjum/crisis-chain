DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/crisis_pool

# ACLED — register at https://developer.acleddata.com/
ACLED_EMAIL=your@email.com
ACLED_API_KEY=your_key

# Severity threshold — regions above this score trigger pool deployment
SEVERITY_DEPLOY_THRESHOLD=60

# Downstream service URLs
AI_SUMMARY_URL=http://ai-summary:8002
BLOCKCHAIN_BRIDGE_URL=http://blockchain-bridge:4001
