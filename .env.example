# ============================================================
# CrisisChain — master .env.example
# Copy to .env and fill in real values.
# Never commit .env to git.
# ============================================================

# ── Blockchain ─────────────────────────────────────────────
CHAIN_ID=421614                          # Arbitrum Sepolia
RPC_URL=https://arb-sepolia.g.alchemy.com/v2/[ALCHEMY_KEY]
START_BLOCK=0                            # set to vault deployment block after deploy
CONFIRMATIONS=20

# Contract addresses (fill after deployment)
PRIVATE_KEY=[hex private key — testnet only]
USDC_ADDRESS=0x...
VAULT_ADDRESS=0x...

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crisis_pool

# ── Indexer ─────────────────────────────────────────────────
HTTP_BIND_ADDR=0.0.0.0:3001

# ── API Gateway ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── Frontend ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
WALLETCONNECT_PROJECT_ID=[get from cloud.walletconnect.com]
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_VAULT_ADDRESS=0x...
NEXT_PUBLIC_USDC_ADDRESS=0x...
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=[same as above]

# ── Crisis Intelligence ──────────────────────────────────────
ACLED_EMAIL=your@email.com
ACLED_API_KEY=[get from developer.acleddata.com]
SEVERITY_DEPLOY_THRESHOLD=60

# ── AI Summary ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── IPFS (Pinata) ────────────────────────────────────────────
PINATA_API_KEY=[get from pinata.cloud]
PINATA_SECRET_KEY=[get from pinata.cloud]

# ── Optional: Google Vision OCR ──────────────────────────────
# GOOGLE_VISION_CREDENTIALS=/path/to/credentials.json
