# ============================================================
# CrisisChain — master .env.example
# Copy to .env and fill in real values.
# Never commit .env to git.
# ============================================================

# FRONT END MAP
VITE_MAPBOX_TOKEN=pk.xxxxxxxxxxxxx
ACLED_USERNAME=your_email@example.com
ACLED_PASSWORD=your_password

# ── Blockchain ─────────────────────────────────────────────
CHAIN_ID=7080969                          # Humanity Testnet
RPC_URL=https://humanity-testnet.g.alchemy.com/public
START_BLOCK=0                            # set to vault deployment block after deploy
CONFIRMATIONS=20

# Contract addresses (fill after deployment)
PRIVATE_KEY=[hex private key — testnet only]
USDC_ADDRESS=0x...
VAULT_ADDRESS=0x...

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crisis_pool

# ── Indexer ─────────────────────────────────────────────────
HTTP_BIND_ADDR=0.0.0.0:3001

# ── API Gateway ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production
# Only if you run api-gateway ON YOUR MACHINE (npm run dev), not in Docker:
# CRISIS_INTELLIGENCE_URL=http://127.0.0.1:8001
# Docker Compose sets http://crisis-intelligence:8001 inside the gateway container — do not use localhost there.

# ── Frontend ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
WALLETCONNECT_PROJECT_ID=[get from cloud.walletconnect.com]
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_INDEXER_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=7080969
NEXT_PUBLIC_VAULT_ADDRESS=0x...
NEXT_PUBLIC_USDC_ADDRESS=0x...
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=[same as above]

# ── Crisis Intelligence ──────────────────────────────────────
# ACLED OAuth (password grant): tokens cached in memory; refreshed via refresh_token before expiry.
ACLED_EMAIL=your@email.com
ACLED_PASSWORD=your_myacled_password
# Optional: use a fixed Bearer token instead of OAuth (e.g. CI); normally leave empty
ACLED_ACCESS_TOKEN=
# ACLED query window end = min(today, YYYY-12-31) unless you set ACLED_QUERY_END_DATE.
# If your clock is ahead of what ACLED has published, set an older cap or end date:
# ACLED_DATA_CAP_YEAR=2024
# ACLED_QUERY_END_DATE=2025-12-31
SEVERITY_DEPLOY_THRESHOLD=60
# Cap orgs per region for HDX HAPI → CKAN resolution pipeline (1–50). Lower for faster demos.
NGO_DISCOVERY_PER_REGION_LIMIT=50

# ── HDX HAPI v2 (NGO operational presence) ─────────────────────
# https://hapi.humdata.org/docs — optional if ACLED_EMAIL is set (same value used for encode_app_identifier)
# HDX_HAPI_CONTACT_EMAIL=your@email.com
HDX_HAPI_APPLICATION_NAME=CrisisChain
# Optional: pre-encoded token (skip encode call); optional base override
# HDX_HAPI_APP_IDENTIFIER=
# HDX_HAPI_BASE=https://hapi.humdata.org

# ── AI Summary ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── IPFS (Pinata) ────────────────────────────────────────────
PINATA_API_KEY=[get from pinata.cloud]
PINATA_SECRET_KEY=[get from pinata.cloud]

# ── Optional: Google Vision OCR ──────────────────────────────
# GOOGLE_VISION_CREDENTIALS=/path/to/credentials.json
